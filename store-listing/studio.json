{
  "app": "Calcula",
  "locales": [
    "en-US",
    "de-DE",
    "es-ES",
    "fr-FR",
    "it-IT",
    "ja-JP",
    "pt-BR",
    "zh-CN",
    "zh-TW"
  ],
  "defaultLocale": "en-US",
  "writeAssets": false,
  "jpegQuality": 96,
  "contactSheets": {
    "phone": "contact-sheet-joined.jpg",
    "tablet7": "tablet7/contact-sheet-joined.jpg",
    "tablet10": "tablet10/contact-sheet-joined.jpg",
    "desktop": false
  },
  "supersample": 2,
  "capture": {
    "build": "./gradlew :androidApp:assembleStoreCapture -q",
    "runs": [
      {
        "profiles": [
          "phone",
          "tablet7",
          "tablet10",
          "desktop"
        ],
        "locales": [
          "en-US",
          "de-DE",
          "es-ES",
          "pt-BR"
        ]
      }
    ],
    "export": "cd store-listing && node render.mjs --locale {locale}"
  },
  "frames": {
    "phone": {
      "bezel": 0.022,
      "radius": 0.075
    },
    "tablet": {
      "bezel": 0.022,
      "radius": 0.075
    },
    "landscape": {
      "bezel": 0.011,
      "radius": 0.03
    },
    "fixed": [
      "compare"
    ]
  },
  "bounds": {
    "margin": 12,
    "visible": 0.7,
    "layouts": {
      "stack": false,
      "compare": false,
      "hero": {
        "visible": 0.5
      },
      "five": {
        "visible": 0.4
      }
    }
  }
}